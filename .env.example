# Arcane Vault — Environment Configuration Example
# Copy to .env and fill in values (NEVER commit .env to GitHub)

DJANGO_SECRET_KEY=change-me-to-a-secure-50-char-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,arcvault.example.com
BASE_URL=https://arcvault.example.com
SQLITE_DB_PATH=/app/data/db.sqlite3

# Admin / Superuser Auto-Promotion (Email authenticated via Google OIDC)
ARCANE_ADMIN_EMAIL=your-admin-email@example.com

# Native Google OIDC Authentication
GOOGLE_OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_SECRET=your-google-client-secret

# Optional Gemini API Key for AI Vision Card Scanning (/api/v1/collection/vision-scan)
GEMINI_API_KEY=

# GitHub Auto-Sync Configuration (Used by Pompeii container entrypoint)
GITHUB_REPO_URL=https://github.com/SandCaciel/Arcane-Vault.git
GITHUB_BRANCH=main
GIT_SYNC_INTERVAL_SECONDS=60
